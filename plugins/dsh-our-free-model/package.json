{
  "name": "dsh-our-free-model",
  "version": "1.3.1-localfirst.1",
  "private": true,
  "type": "module",
  "description": "Our Free Model (local-first fork) — 免登录免 API Key 使用上游免费模型；本版本已移除全部远程代码依赖：不联网检查更新、不拉取模型清单、不轮询远程公告、不探测出口 IP，也不会写入或替换自己的安装目录。内置静态模型清单，公告读自本机文件，仅与模型网关通信。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node scripts/test-all.mjs",
    "selftest": "node scripts/host-selftest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "index.js",
    "client.js",
    "adapter",
    "src",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README_EN.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "free-model",
    "llm-provider",
    "local-first",
    "no-telemetry"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
